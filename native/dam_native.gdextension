[configuration]

entry_symbol = "dam_native_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://native/bin/linux/libdam_native.linux.template_debug.x86_64.so"
android.debug.arm64 = "res://native/bin/android/libdam_native.android.template_debug.arm64.so"
